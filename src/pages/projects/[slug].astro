---
import type { GetStaticPaths } from 'astro'
import Layout from '~/layouts/Layout.astro'
import { getSortedProjects } from '~/projects'
import { render } from 'astro:content'
import PostInfo from '~/components/PostInfo.astro'
import TableOfContents from '~/components/TableOfContents.astro'
import ScrollUpButton from '~/components/ScrollUpButton.astro'

export const getStaticPaths = (async () => {
  const projects = await getSortedProjects()
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }))
}) satisfies GetStaticPaths

const { project } = Astro.props
const projectData = project.data
const { headings, Content: ProjectContent } = await render(project)
---

<Layout
  title={projectData.title}
  description={projectData.description}
  author={projectData.author}
>
  <article class="max-w-full py-7.5" data-pagefind-body>
    <div class="md:mx-2">
      <h1 id={project.id} class="mb-4 text-[1.75rem] text-heading1 font-semibold">
        # {projectData.title}
      </h1>
      <div class="my-2 border-l-2 border-accent/80 pl-4 py-2">
        <PostInfo post={project} class="mb-1" />
      </div>
    </div>
    <div class="flex flex-col xl:gap-1 2xl:gap-18 xl:flex-row xl:items-start">
      {projectData.toc && headings.length > 0 && <TableOfContents headings={headings} />}
      <div class="mb-5 xl:min-w-full 2xl:min-w-full prose">
        <ProjectContent />
      </div>
    </div>
  </article>
  <ScrollUpButton />
</Layout>
